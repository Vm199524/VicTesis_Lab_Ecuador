# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_KEY: clave privada del panel de guia de correccion (/#admin).
# Sin ella el endpoint /api/admin/draft-guidance queda deshabilitado.
ADMIN_KEY="MI_CLAVE_PRIVADA"

# AUTH_SECRET: firma de las cookies de sesion. Obligatoria en produccion.
AUTH_SECRET="cadena-larga-y-aleatoria"

# Inicio de sesion con Google (Google Cloud Console > Credenciales > ID de cliente OAuth)
# URI de redireccion autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Inicio de sesion con GitHub (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google AdSense (opcional). Sin CLIENT el portal no carga ningun script de
# publicidad: no hay recuadros vacios ni peticiones a Google.
# El prefijo VITE_ es obligatorio para que Vite lo exponga al navegador.
VITE_ADSENSE_CLIENT=""
VITE_ADSENSE_SLOT_HOME=""

# Servicio de verificacion de originalidad (detector de plagio/IA).
# URL del detector que el portal alcanza desde el servidor (proxy /api/originality/*).
ORIGINALITY_API_URL="http://127.0.0.1:5000"

# (Build de produccion / Firebase Hosting) URL publica del Cloud Run del portal.
# Firebase Hosting corta sus rewrites a Cloud Run a los 60 s, y un analisis de
# una tesis completa dura varios minutos. Con esta variable (solo en el build;
# p. ej. .env.production) el navegador llama directo al Cloud Run del portal,
# cuyo timeout es de 900 s, y el analisis largo ya no muere en la pasarela.
# Sin ella, el modulo usa el mismo origen (adecuado en desarrollo).
# VITE_ORIGINALITY_API_URL="https://<servicio>-<project-number>.<region>.run.app"
