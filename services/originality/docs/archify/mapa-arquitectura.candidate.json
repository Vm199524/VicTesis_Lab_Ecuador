  "cards": [
    {
      "dot": "cyan",
      "title": "Flujo de detección",
      "items": [
        "Usuario carga PDF/DOCX → extractText() detecta formato por magic numbers",
        "Texto → chunking(12-60 palabras) → búsqueda de fuentes (5 proveedores)",
        "Scoring: containment(4-gram, 7-gram) + cosine TF-IDF + winnowing + longest run"
      ]
    },
    {
      "dot": "rose",
      "title": "Estrategia de búsqueda",
      "items": [
        "Dual-query: exact phrase (8 palabras, alta precisión) + keywords (10 palabras, high recall)",
        "Round-robin merge de resultados (Wikipedia EN/ES, CrossRef, OpenAlex, DuckDuckGo)",
        "Caché LRU en memoria (500 URLs) → evita re-fetches redundantes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Capacidad y desempeño",
      "items": [
        "Máx: 120.000 caracteres · 120 chunks analizados (muestreo adaptativo)",
        "Concurrencia: 6 requests paralelos (pool) · Timeout: 8s por URL",
        "Métricas expuestas: containment%, cosine%, fingerprint%, longest_run_tokens"
      ]
    }
  ]
