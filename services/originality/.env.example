# ===========================================================================
# Identificacion ante las APIs academicas
# ===========================================================================
# CrossRef, OpenAlex y Unpaywall enrutan las peticiones que llevan un correo
# de contacto a un pool mas rapido y permisivo. Unpaywall lo exige.
CONTACT_EMAIL=

# ===========================================================================
# Claves opcionales
#
# Cada proveedor sin clave simplemente se omite. Ninguno es obligatorio: el
# analisis funciona sin ninguna clave, con menor cobertura.
# ===========================================================================

# CORE (core.ac.uk) — EL DE MAYOR IMPACTO.
# ~300M trabajos open access CON TEXTO COMPLETO, no solo resumenes.
# Clave gratuita: https://core.ac.uk/services/api
CORE_API_KEY=

# Semantic Scholar — sin clave responde 429 con frecuencia.
# Clave gratuita: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Busqueda web de pago. Sustituyen a DuckDuckGo donde este bloqueado.
SERPER_API_KEY=
BRAVE_API_KEY=

# ===========================================================================
# Modelos locales
#
# Se descargan solos en el primer uso y quedan en TRANSFORMERS_CACHE.
# Sin ellos el sistema sigue funcionando con metricas lexicas y estilometria,
# reportando menor confianza.
# ===========================================================================

# Similitud semantica (~120 MB). Detecta parafraseo y cruza idiomas.
SEMANTIC_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_DISABLED=

# Deteccion de IA por perplejidad (~350 MB). Multilingue.
AI_DETECT_MODEL=onnx-community/Qwen2.5-0.5B
AI_DETECT_DISABLED=

TRANSFORMERS_CACHE=./.models

# ===========================================================================
# Corpus local
#
# Base de trabajos previos. Es lo que permite detectar copia entre estudiantes,
# que ningun indice web puede cubrir. La retencion es opt-in por documento:
# nada se almacena por el solo hecho de analizarlo.
# ===========================================================================
CORPUS_DB=./data/corpus.db

# ===========================================================================
# Limites de ejecucion
# ===========================================================================
PORT=5000
MAX_CHARS=120000
MAX_CHUNKS=120
FETCH_CONCURRENCY=6
PROVIDER_TIMEOUT_MS=9000
MAX_SOURCE_PDF_BYTES=12582912
QUERY_CACHE_TTL_MS=900000

# Ruta a un Chrome del sistema, si no se quiere el Chromium de Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
